---
export interface Props {
  title: string;
  description: string;
  image?: string;
}

const base = import.meta.env.BASE_URL;
const { title, description, image = `${base}favicon.svg` } = Astro.props;
const siteName = "Paws & Progress";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --color-bg: #fdfaf6;
    --color-text: #2b2320;
    --color-accent: #b3541e;
    --color-muted: #746a63;
    --color-border: #e6ddd3;
    --color-card-bg: #ffffff;

    --cat-puppy-basics-bg: #fdecc8;
    --cat-puppy-basics-text: #8a5a12;
    --cat-behavior-problems-bg: #f6d9d0;
    --cat-behavior-problems-text: #a13f22;
    --cat-obedience-commands-bg: #d9e9e7;
    --cat-obedience-commands-text: #1f6b63;
    --cat-rescue-multi-dog-bg: #e7dcf1;
    --cat-rescue-multi-dog-text: #5b3a8a;
    --cat-general-guides-bg: #e3e2df;
    --cat-general-guides-text: #55524c;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
  }
  main {
    max-width: 780px;
    margin: 0 auto;
    padding: 1.5rem;
  }
  a {
    color: var(--color-accent);
  }
  h1, h2, h3 {
    line-height: 1.25;
  }

  .badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .badge--puppy-basics {
    background: var(--cat-puppy-basics-bg);
    color: var(--cat-puppy-basics-text);
  }
  .badge--behavior-problems {
    background: var(--cat-behavior-problems-bg);
    color: var(--cat-behavior-problems-text);
  }
  .badge--obedience-commands {
    background: var(--cat-obedience-commands-bg);
    color: var(--cat-obedience-commands-text);
  }
  .badge--rescue-multi-dog {
    background: var(--cat-rescue-multi-dog-bg);
    color: var(--cat-rescue-multi-dog-text);
  }
  .badge--general-guides {
    background: var(--cat-general-guides-bg);
    color: var(--cat-general-guides-text);
  }
</style>
