---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Disclosure from "../../components/Disclosure.astro";
import AffiliateCTA from "../../components/AffiliateCTA.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allArticles = await getCollection("articles");
const others = allArticles.filter((a) => a.id !== article.id);

function sharedKeywordCount(a: (typeof others)[number]) {
  return a.data.keywords.filter((k) => article.data.keywords.includes(k)).length;
}

const related = others
  .map((a) => ({ a, score: sharedKeywordCount(a) }))
  .sort((x, y) => y.score - x.score || y.a.data.publishDate.valueOf() - x.a.data.publishDate.valueOf())
  .slice(0, 3)
  .map(({ a }) => a);

const base = import.meta.env.BASE_URL;
const wordCount = article.body ? article.body.trim().split(/\s+/).length : 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const canonicalURL = new URL(`${base}articles/${article.id}/`, Astro.site);
const siteHome = new URL(base, Astro.site);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishDate.toISOString(),
  author: { "@type": "Organization", name: "Paws & Progress" },
  publisher: { "@type": "Organization", name: "Paws & Progress" },
  mainEntityOfPage: canonicalURL.toString(),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteHome.toString() },
    { "@type": "ListItem", position: 2, name: "Articles", item: siteHome.toString() },
    { "@type": "ListItem", position: 3, name: article.data.title, item: canonicalURL.toString() },
  ],
};
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <Header />
  <main>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={base}>Home</a> <span>/</span> <span aria-current="page">{article.data.title}</span>
    </nav>
    <article>
      <h1>{article.data.title}</h1>
      <p class="meta">
        {article.data.publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        &middot; {readingMinutes} min read
      </p>
      <Disclosure />
      <div class="content">
        <Content />
      </div>
      <AffiliateCTA offerKey={article.data.offerKey} />
    </article>

    {
      related.length > 0 && (
        <section class="related">
          <h2>Related Articles</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`${base}articles/${r.id}/`}>{r.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>

<style>
  .breadcrumbs {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  .breadcrumbs a {
    color: var(--color-muted);
  }
  .meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-top: -0.5rem;
  }
  .content :global(h2) {
    margin-top: 2rem;
  }
  .content :global(p) {
    margin: 1rem 0;
  }
  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.25rem;
  }
  .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .related h2 {
    font-size: 1.1rem;
  }
  .related ul {
    list-style: none;
    padding: 0;
  }
  .related li {
    padding: 0.5rem 0;
  }
</style>
