---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="About Paws & Progress"
  description="Why we write about dog training and how we choose the resources we recommend."
>
  <Header />
  <main>
    <h1>About Paws & Progress</h1>
    <p>
      Paws & Progress is a small, independent site focused on one thing: practical dog
      training advice that actually works for everyday owners. No fluff, no filler —
      just step-by-step guides for the problems real dogs and their people run into.
    </p>
    <p>
      We research each topic carefully and link out to training programs and products
      we believe are genuinely useful. Some of those links are affiliate links, which
      means we may earn a small commission if you make a purchase — at no extra cost to
      you. See our <a href={`${base}privacy/`}>Privacy &amp; Affiliate Disclosure</a> page for
      details.
    </p>
  </main>
  <Footer />
</BaseLayout>
